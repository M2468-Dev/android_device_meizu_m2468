# Initialize AOD brightness and tap gestures after boot.
on property:sys.boot_completed=1
    write /sys/kernel/display_drivers/aod_light_mode 0
    write /sys/devices/platform/main_touch.0/gesture/double_en 1
    write /sys/devices/platform/main_touch.0/gesture/single_en 1

# Recover panel state if the fingerprint service exits or restarts.
on property:init.svc.vendor.fingerprint-meizu=stopped
    write /sys/kernel/display_drivers/hbm 7
    write /sys/devices/platform/main_touch.0/gesture/fod_en 0

on property:init.svc.vendor.fingerprint-meizu=restarting
    write /sys/kernel/display_drivers/hbm 7
    write /sys/devices/platform/main_touch.0/gesture/fod_en 0
