# SPDX-License-Identifier: Apache-2.0
service vendor.fingerprint-meizu /vendor/bin/hw/android.hardware.biometrics.fingerprint-service.meizu
    class late_start
    user system
    group system input
    interface aidl android.hardware.biometrics.fingerprint.IFingerprint/default

on post-fs-data
    mkdir /data/vendor/fingerprint 0770 system system
    mkdir /mnt/vendor/persist/fingerprint 0770 system system
    mkdir /mnt/vendor/persist/fingerprint/jiiov 0770 system system
