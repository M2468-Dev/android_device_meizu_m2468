// SPDX-License-Identifier: Apache-2.0

cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.meizu",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint-service.meizu.rc"],
    vintf_fragments: ["fingerprint-service.xml"],
    srcs: [
        "AncBackend.cpp",
        "Fingerprint.cpp",
        "Panel.cpp",
        "SerialExecutor.cpp",
        "Session.cpp",
        "UdfpsHandler.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.biometrics.common-V3-ndk",
        "android.hardware.biometrics.fingerprint-V3-ndk",
        "android.hardware.keymaster-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "libdl",
        "liblog",
    ],
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
